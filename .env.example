# 环境变量配置
# 百度网盘配置
ACCESS_TOKEN=your_access_token_here

# 服务配置
APP_NAME=Yunpan HLS Proxy
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 缓存配置
CACHE_DIR=./cache
CACHE_TTL=3600
CACHE_SEGMENTS=False  # 是否缓存HLS分片文件 (默认: 不缓存)

# HLS配置
YUN_PATH_PREFIX=/apps/movies  # 网盘HLS存储根路径

# 本地HLS文件存储目录（如果目录存在则自动启用本地模式）
LOCAL_PATH=./local_hls

# 目录 API 代理（影片库首页 /api/catalog/*）
# base 必须来自配置；客户端不能覆盖，避免变成开放代理。
CATALOG_API_BASE=http://127.0.0.1:8010
# 可选：向上游目录 API 透传 Bearer token
# CATALOG_API_TOKEN=
# 请求上游目录 API 的超时（秒）
CATALOG_TIMEOUT=10.0
# 环境变量配置
# 百度网盘配置
ACCESS_TOKEN=your_access_token_here

# 服务配置
APP_NAME=Yunpan HLS Proxy
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# 缓存配置
CACHE_DIR=./cache
CACHE_TTL=3600
CACHE_ENABLED=True  # 是否启用磁盘缓存 (Vercel 等只读文件系统应设为 False)
CACHE_SEGMENTS=False  # 是否缓存HLS分片文件 (默认: 不缓存)

# Redis / Upstash (Vercel KV) 配置 - 用于跨实例存储 fsid
# 兼容多种注入的环境变量名: 自定义 REDIS_URL / Vercel KV / Upstash Marketplace
# REDIS_URL=
# REDIS_TOKEN=

# HLS配置
YUN_PATH_PREFIX=/apps/movies  # 网盘HLS存储根路径

# 本地HLS文件存储目录（如果目录存在则自动启用本地模式）
LOCAL_PATH=./local_hls

# httpx 请求日志控制（默认关闭，避免打印请求URL等敏感信息）
# HTTPX_LOG=False

# 目录 API 代理配置（影片库首页拉取列表/详情的外部服务）
CATALOG_API_BASE=http://127.0.0.1:8010
# CATALOG_API_TOKEN=
CATALOG_TIMEOUT=10.0
